{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "E-Commerce Product Schema",
  "description": "Validates product listings generated by LLMs",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]{8,12}$",
      "description": "Unique product identifier (alphanumeric, 8-12 chars)"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "description": "Product name"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "Detailed product description"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true,
      "description": "Product price (must be positive)"
    },
    "currency": {
      "type": "string",
      "enum": ["USD", "EUR", "GBP", "JPY", "CAD"],
      "default": "USD"
    },
    "category": {
      "type": "string",
      "enum": [
        "electronics",
        "clothing",
        "books",
        "home",
        "sports",
        "toys",
        "food",
        "other"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 30
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "description": "Product tags for search and filtering"
    },
    "inventory": {
      "type": "object",
      "properties": {
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "warehouse": {
          "type": "string",
          "enum": ["US-EAST", "US-WEST", "EU-CENTRAL", "ASIA-PAC"]
        },
        "reserved": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["quantity"]
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "specifications": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "available": {
      "type": "boolean",
      "description": "Whether product is currently available for purchase"
    }
  },
  "required": ["id", "name", "price", "category"],
  "additionalProperties": false
}
