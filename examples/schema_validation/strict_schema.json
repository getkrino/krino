{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strict API Response Schema",
  "description": "Strict schema that rejects any additional properties",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error", "pending"]
    },
    "code": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "message": {
      "type": "string",
      "maxLength": 500
    },
    "data": {
      "type": "object"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    }
  },
  "required": ["status", "code"],
  "additionalProperties": false,
  "description": "With additionalProperties: false, any field not in 'properties' will cause validation to fail"
}
